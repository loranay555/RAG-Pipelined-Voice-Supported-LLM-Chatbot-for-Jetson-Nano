# ---------------------------------------------------------------------------
# Copy to .env and adjust.  `bash scripts/set_lan_ip.sh` fills SITE_ADDRESS in.
# ---------------------------------------------------------------------------

# --- network ---------------------------------------------------------------
# The address you type on your phone. MUST be https:// for the mic to work.
# Use the Jetson's LAN IP, e.g. https://192.168.1.50:8443
SITE_ADDRESS=https://jetson.local:8443
# Sadece host kismi (semasiz, portsuz). IP'ye baglanan istemciler SNI
# gonderemedigi icin Caddy'nin hangi sertifikayi sunacagini bilmesi sart.
SITE_HOST=jetson.local
HTTP_PORT=8080
HTTPS_PORT=8443

# --- JetPack / CUDA base images -------------------------------------------
# Etiket, karttaki CUDA surumuyle ESLESMELI (host suruculeri konteynere
# baglaniyor, uyusmazsa derleme veya calisma aninda patlar):
#   JetPack 6.0 (L4T r36.3, nvidia-jetpack 6.0)  -> 12.2.12
#   JetPack 6.1/6.2 (L4T r36.4)                  -> 12.6.11
#   JetPack 5.x (L4T r35)                        -> 11.4.19
# Karttaki surum: cat /usr/local/cuda/version.json
L4T_CUDA_DEVEL=nvcr.io/nvidia/l4t-cuda:12.2.12-devel
L4T_CUDA_RUNTIME=nvcr.io/nvidia/l4t-cuda:12.2.12-runtime
# Orin (Ampere) = 87.  Xavier = 72.
CUDA_ARCH=87

# Pin these to a tag/commit once you have a build that works.
LLAMA_CPP_REF=master
WHISPER_CPP_REF=master

# --- LLM -------------------------------------------------------------------
LLM_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
LLM_CTX=8192
LLM_NGL=99
LLM_PARALLEL=1
LLM_BATCH=512
LLM_UBATCH=128
# q8_0 KV cache roughly halves KV memory (1.2 GB -> 0.6 GB at 8k ctx)
LLM_CACHE_TYPE=q8_0
LLM_THREADS=4
LLM_EXTRA_ARGS=

# --- STT -------------------------------------------------------------------
# ggml-small-q5_1.bin  ~190 MB, best Turkish quality/size trade-off
# ggml-base-q5_1.bin   ~57 MB, ~2x faster, noticeably weaker on Turkish
WHISPER_MODEL_FILE=ggml-small-q5_1.bin
WHISPER_THREADS=4
# whisper-server'in varsayilani. Arayuzdeki dil secici her istekte bunu
# gecersiz kilar, o yuzden burasi pratikte sadece yedek.
WHISPER_LANGUAGE=auto
# Arayuzde secim yapilmamissa kullanilacak dil: tr | en | auto
# "auto" varsayilan DEGIL: whisper dili sesin ilk saniyelerinden tahmin ediyor
# ve 2 saniyelik Turkce cumlelerde duzenli olarak Farsca/Arapca'ya kayiyor.
STT_LANGUAGE=tr

# --- assistant behaviour ---------------------------------------------------
# auto = reply in whatever language the user spoke/wrote
ASSISTANT_LANGUAGE=auto
TOOLS_ENABLED=true
# Arac secimi bir siniflandirma; 0.6'da ayni soru bir cagiriyor bir cagirmiyor.
TOOL_DECISION_TEMPERATURE=0.1
# Kac gecmis tur modele gonderilsin. Artirmak prompt'u uzatir ve arac
# cagirmayi bozar; azaltmak takip sorularini zayiflatir.
HISTORY_TURNS=3
MAX_TOOL_ROUNDS=4

# --- voice activity detection ---------------------------------------------
# 0..3, higher = more aggressive at calling things non-speech
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=250
VAD_MAX_UTTERANCE_MS=25000
INTERIM_TRANSCRIPTION=true
INTERIM_INTERVAL_MS=1400

# --- RAG -------------------------------------------------------------------
RAG_TOP_K=4
# e5 cosine scores live in a narrow band: measured on Turkish text, a correct
# chunk lands around 0.83-0.89 and an unrelated one around 0.72-0.80. Below
# ~0.80 you start pulling in noise; above ~0.86 you start dropping real hits.
RAG_MIN_SCORE=0.82
# knowledge_search aracının eşiği; bilinçli arama olduğu için daha gevşek
RAG_TOOL_MIN_SCORE=0.75
# Smaller chunks separate much better than large ones -- a 780-char chunk mixing
# three topics scored 0.82 for both a matching and a non-matching query.
# Changing these invalidates the stored index and forces a full re-ingest.
# false: kullanıcının sorusu modele olduğu gibi gider, dokümanlara yalnızca
# model knowledge_search aracını çağırınca bakılır.
# true: her soruda otomatik olarak alakalı parçalar sistem mesajına eklenir.
ALWAYS_ON_RAG=false
CHUNK_CHARS=450
CHUNK_OVERLAP=80

# --- web tools -------------------------------------------------------------
# Optional. If set, this SearxNG instance is used instead of DuckDuckGo.
# e.g. SEARXNG_URL=http://192.168.1.50:8888
SEARXNG_URL=
HTTP_USER_AGENT=Mozilla/5.0 (X11; Linux aarch64) JetsonAssistant/1.0
